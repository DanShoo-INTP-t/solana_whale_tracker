# Copy this file to ".env" (same folder as main.py) and fill in your values.
# Get a token by chatting with @BotFather on Telegram and sending /newbot.
# Never commit the real .env file to GitHub - only this .env.example file.
BOT_TOKEN=123456789:PASTE_YOUR_TOKEN_FROM_BOTFATHER_HERE

# Optional: only needed if Telegram is blocked on your network.
# Use "socks5://" (not "socks5h://") for SOCKS5 proxies.
# PROXY_URL=socks5://username:password@host:port